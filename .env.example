# Krawl Dashboard
# Pfad unter dem das Dashboard erreichbar ist (muss mit / beginnen)
# WICHTIG: Zufälligen Wert setzen, damit das Dashboard nicht erratbar ist!
# Default (wenn nicht gesetzt): /krawl-eor2msk84z6b
KRAWL_DASHBOARD_SECRET_PATH=/krawl-eor2msk84z6b

# Verzögerung in ms, die der Server vor Antworten wartet (Standard 100)
# KRAWL_DELAY=100

# Canary-Token-URL (optional, für Canary-Token-Detektion)
# KRAWL_CANARY_TOKEN_URL=

# Passwort für die geschützten Dashboard-Panels.
# Nur setzen, wenn ein festes Passwort gewünscht ist.
# NICHT setzen = Krawl generiert ein Passwort (steht in den Container-Logs).
# ACHTUNG: Diese Variable nicht leer mitgeben - ein leerer Wert deaktiviert das Passwort komplett!
# KRAWL_DASHBOARD_PASSWORD=

# Log-Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
KRAWL_LOG_LEVEL=INFO

# Container
PORT=5000
TZ=Europe/Berlin