# Krawl Dashboard
# Pfad unter dem das Dashboard erreichbar ist (muss mit / beginnen)
# WICHTIG: Zufälligen Wert setzen, damit das Dashboard nicht erratbar ist!
# Default (wenn nicht gesetzt): /home/KRAWL
KRAWL_DASHBOARD_SECRET_PATH=/home/KRAWL

# Verzögerung in ms, die der Server vor Antworten wartet (Standard 100)
# KRAWL_DELAY=100

# Canary-Token-URL (optional, für Canary-Token-Detektion)
# KRAWL_CANARY_TOKEN_URL=

# Eigene Fake-Seite als HTML-Template (optional).
# Beispiel-Template: templates/custom_page.html im Repo.
# 1) Host-Ordner wird standardmäßig gemountet: ${KRAWL_TEMPLATES_HOST_DIR:-/templates}:/templates:ro
#    (Legt die Datei also z.B. unter /templates/custom_page.html auf dem Host ab.)
# 2) Diese Variable auf den Pfad IM Container setzen (leer lassen = Standard-Seite):
# KRAWL_CUSTOM_TEMPLATE_PATH=/templates/custom_page.html
# Template muss die Platzhalter {counter} und {content} enthalten.

# Passwort für die geschützten Dashboard-Panels.
# Nur setzen, wenn ein festes Passwort gewünscht ist.
# NICHT setzen = Krawl generiert ein Passwort (steht in den Container-Logs).
# ACHTUNG: Diese Variable nicht leer mitgeben - ein leerer Wert deaktiviert das Passwort komplett!
# KRAWL_DASHBOARD_PASSWORD=

# Log-Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
KRAWL_LOG_LEVEL=INFO

# ============================================================
# KI-generierte Fake-Seiten (AI-Generated Deception Pages)
# ============================================================
# Erzeugt auf unbekannte Pfade realistische Fake-Seiten per LLM.
# Standard: AUS. Zum Aktivieren: KRAWL_AI_ENABLED=true + API-Key setzen.
#
# Provider: "openrouter" (Default, kostenlose Modelle möglich)
#           oder "openai" (OpenAI-API oder self-hosted OpenAI-kompatibler
#           Endpoint, z.B. Ollama/llama.cpp via http://krawl-llm:8080/v1)
#
# KRAWL_AI_ENABLED=false
# KRAWL_AI_PROVIDER=openrouter
# KRAWL_AI_OPENAI_BASE_URL=https://api.openai.com/v1
# KRAWL_AI_API_KEY=
# KRAWL_AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# KRAWL_AI_TIMEOUT=300
# KRAWL_AI_MAX_DAILY_REQUESTS=100
# KRAWL_AI_REASONING_ENABLED=false
# KRAWL_AI_REASONING_EFFORT=medium

# Container
PORT=5000
TZ=Europe/Berlin